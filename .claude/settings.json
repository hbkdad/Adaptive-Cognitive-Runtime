{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/claude_acr_hook.py\" preflight --database \"${CLAUDE_PROJECT_DIR}/.acr/acr.db\" --scope acr --subject-id claude-code-local",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/claude_acr_hook.py\" postflight",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
